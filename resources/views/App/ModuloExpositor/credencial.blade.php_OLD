    </div>
    <script>
        let credenciales = @json($viewData['credencial_tipo_exposicion']);
        
        function switchTableCredencial(indexCredencial) {
            $('.button-table-credencial').removeClass('btn-success');
            $('.button-table-credencial').addClass('btn-primary');

            $('#buttonTableCredencial'+indexCredencial).removeClass('btn-primary');
            $('#buttonTableCredencial'+indexCredencial).addClass('btn-success');

            $('*[id^="tbodyCredenciales"]').addClass('d-none');

            let input = document.getElementsByName('cantidad[]');

            for (let i = $('#tbodyCredenciales'+indexCredencial+' tr').length; i < input[indexCredencial].value; i++) {

                $('#tbodyCredenciales'+indexCredencial).append(`
                    <tr>
                        <td>
                            <input name="nombre${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                        <td>
                            <input name="apellido${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                        <td>
                            <input name="empresa${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                        <td>
                            <input name="cargo${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                        <td>
                            <input name="email${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                        <td>
                            <input name="telefono${indexCredencial}[]" class="form-control bg-white" />
                        </td>
                    </tr>
                `);
            }

            $('#tbodyCredenciales'+indexCredencial).removeClass('d-none');
        }
    </script>
